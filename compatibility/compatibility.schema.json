{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gala:internal:compatibility-catalog:2.0.0",
  "type": "object",
  "required": ["schemaVersion", "sourceDesignRevision", "contracts", "digest"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "sourceDesignRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contracts": {
      "type": "array",
      "items": { "$ref": "#/$defs/contract" },
      "minItems": 21,
      "maxItems": 21
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "contract": {
      "type": "object",
      "required": ["contractId", "producer", "consumers"],
      "properties": {
        "contractId": {
          "type": "string",
          "pattern": "^urn:gala:(?:schema|metadata):[a-z0-9]+(?:-[a-z0-9]+)*:2\\.0\\.0$"
        },
        "producer": { "$ref": "#/$defs/producer" },
        "consumers": {
          "type": "array",
          "items": { "$ref": "#/$defs/consumer" },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "producer": {
      "type": "object",
      "required": [
        "artifact",
        "version",
        "oldestAcceptedVersion",
        "previousSupportedVersion",
        "previousVersionDisposition",
        "status",
        "introducedOn",
        "deprecatedOn",
        "retiredOn",
        "supportEvidence"
      ],
      "properties": {
        "artifact": { "const": "@rathnasgala2/schemas" },
        "version": { "const": "2.0.0" },
        "oldestAcceptedVersion": { "const": "2.0.0" },
        "previousSupportedVersion": { "const": null },
        "previousVersionDisposition": {
          "const": "INITIAL_RELEASE_NO_PREVIOUS_VERSION"
        },
        "status": {
          "enum": ["current", "supported", "deprecated", "retired"]
        },
        "introducedOn": { "const": "2026-09-06" },
        "deprecatedOn": {
          "oneOf": [{ "type": "string", "format": "date" }, { "type": "null" }]
        },
        "retiredOn": {
          "oneOf": [{ "type": "string", "format": "date" }, { "type": "null" }]
        },
        "supportEvidence": {
          "const": ["DEC-071", "DEC-078", "S0-T05"]
        }
      },
      "additionalProperties": false
    },
    "consumer": {
      "type": "object",
      "required": ["artifact", "version", "supportedProducerRange"],
      "properties": {
        "artifact": {
          "enum": [
            "api",
            "app",
            "infra",
            "publish",
            "template",
            "theme-amaze",
            "theme-default",
            "theme-flashy",
            "theme-minimal",
            "theme-zebra"
          ]
        },
        "version": { "const": "2.0.0" },
        "supportedProducerRange": { "const": ">=2.0.0 <2.1.0" }
      },
      "additionalProperties": false
    }
  }
}
